# Normalize line endings to LF in the repository for all text files.
# This silences the CRLF conversion warnings on Windows and keeps diffs clean
# across platforms.
* text=auto eol=lf

# Be explicit for the file types in this workspace.
*.rs    text eol=lf
*.toml  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
Cargo.lock text eol=lf
